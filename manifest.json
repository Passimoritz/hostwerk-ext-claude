{
  "$schema": "https://raw.githubusercontent.com/Passimoritz/hostwerk-public/main/sdk/manifest.schema.json",
  "id": "claude",
  "color": "#d97757",
  "category": "ai",
  "name": {
    "de": "KI-Anbindung",
    "en": "AI Connect"
  },
  "description": {
    "de": "Deine KIs mit Hostwerk verbinden: Gedächtnis für jede KI (Claude, OpenAI, Gemini, lokal …) genau einstellen, Claude Desktop und Claude Code anbinden, im Projekt loslegen, Tokens sparen, Tipps & Tricks.",
    "en": "Connect your AIs with Hostwerk: fine-tune the memory every AI gets (Claude, OpenAI, Gemini, local …), connect Claude Desktop and Claude Code, get going in your project, save tokens, tips & tricks."
  },
  "permissions": [
    "read:claude",
    "change:claude",
    "run:terminal",
    "read:knowledge",
    "connect:claude",
    "storage"
  ],
  "page": {
    "title": {
      "de": "KI-Anbindung",
      "en": "AI Connect"
    },
    "description": {
      "de": "Was jede KI über dich und deine Projekte weiß – und wie Claude & Co. mit deinen Projekten arbeiten.",
      "en": "What every AI knows about you and your projects – and how Claude & co. work with your projects."
    },
    "icon": "sparkles",
    "file": "page/index.html",
    "tabs": [
      {
        "id": "memory",
        "title": {
          "de": "Gedächtnis",
          "en": "Memory"
        },
        "icon": "sparkles"
      },
      {
        "id": "go",
        "title": {
          "de": "Loslegen",
          "en": "Get going"
        },
        "icon": "rocket"
      },
      {
        "id": "connect",
        "title": {
          "de": "Verbinden",
          "en": "Connect"
        },
        "icon": "network"
      },
      {
        "id": "tokens",
        "title": {
          "de": "Token sparen",
          "en": "Save tokens"
        },
        "icon": "gauge"
      },
      {
        "id": "tips",
        "title": {
          "de": "Tipps & Tricks",
          "en": "Tips & tricks"
        },
        "icon": "star"
      },
      {
        "id": "log",
        "title": {
          "de": "Protokoll",
          "en": "Log"
        },
        "icon": "list"
      }
    ]
  },
