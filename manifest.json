{
  "$schema": "https://raw.githubusercontent.com/Passimoritz/hostwerk-public/main/sdk/manifest.schema.json",
  "id": "claude",
  "color": "#d97757",
  "category": "ai",
  "name": {
    "de": "KI-Anbindung",
    "en": "AI Connect"
  },
  "description": {
    "de": "Jede KI mit Hostwerk verbinden – Cursor, VS Code, Windsurf, LM Studio, Claude, Codex, Gemini CLI und jede andere MCP-App: Gedächtnis je KI einstellen, App mit einem Klick bzw. passendem Weg anbinden, im Projekt loslegen, Tokens sparen, Tipps & Tricks. Steckt im KI-Helfer als Reiter „KI-Anbindung“.",
    "en": "Connect any AI with Hostwerk – Cursor, VS Code, Windsurf, LM Studio, Claude, Codex, Gemini CLI and any other MCP app: set the memory each AI gets, connect your app in one click or the right way for it, get going in your project, save tokens, tips & tricks. Lives in the AI assistant as the “AI Connect” tab."
  },
  "permissions": [
    "read:claude",
    "change:claude",
    "run:terminal",
    "read:knowledge",
    "connect:claude",
    "storage",
    "native",
    "extend:extensions"
  ],
  "page": {
    "title": {
      "de": "KI-Anbindung",
      "en": "AI Connect"
    },
    "description": {
      "de": "Was jede KI über dich und deine Projekte weiß – und wie deine KI-Werkzeuge mit deinen Projekten arbeiten.",
      "en": "What every AI knows about you and your projects – and how your AI tools work with your projects."
    },
    "icon": "sparkles",
    "file": "page/index.html",
    "tabs": [
      {
        "id": "memory",
        "title": {
          "de": "Gedächtnis",
          "en": "Memory"
        },
        "icon": "sparkles"
      },
      {
        "id": "go",
        "title": {
          "de": "Loslegen",
          "en": "Get going"
        },
        "icon": "rocket"
      },
      {
        "id": "connect",
        "title": {
          "de": "Verbinden",
          "en": "Connect"
        },
        "icon": "network"
      },
      {
        "id": "tokens",
        "title": {
          "de": "Token sparen",
          "en": "Save tokens"
        },
        "icon": "gauge"
      },
      {
        "id": "tips",
        "title": {
          "de": "Tipps & Tricks",
          "en": "Tips & tricks"
        },
        "icon": "star"
      },
      {
        "id": "log",
        "title": {
          "de": "Protokoll",
          "en": "Log"
        },
        "icon": "list"
      }
    ],
    "nav": false
  },
  "version": "1.5.1",
  "author": "Hostwerk",
  "homepage": "https://github.com/Passimoritz/hostwerk-ext-claude",
  "license": "MIT",
  "icon": "icon.svg",
  "banner": "banner.svg",
  "videos": "videos/index.json",
  "hostwerk": ">=2.9.0",
  "backend": "server/index.js",
  "settingsTab": "notifications",
  "settings": [
    {
      "key": "dailyTokens",
      "type": "number",
      "label": {
        "de": "Claude Code: Token-Tagesgrenze (0 = aus)",
        "en": "Claude Code: daily token limit (0 = off)"
      },
      "default": 0,
      "min": 0,
      "max": 100000000
    },
    {
      "key": "budgetNotify",
      "type": "switch",
      "label": {
        "de": "Bei 80 % und beim Erreichen der Tagesgrenze benachrichtigen",
        "en": "Notify at 80 % and when the daily limit is reached"
      },
      "default": true
    }
  ],
  "contributes": {
    "tabs": [
      {
        "id": "anbindung",
        "on": "area:ai",
        "page": true,
        "title": {
          "de": "KI-Anbindung",
          "en": "AI Connect"
        },
        "icon": "network",
        "file": "page/index.html"
      },
      {
        "id": "go",
        "on": "area:projects",
        "title": {
          "de": "Mit KI loslegen",
          "en": "Get going with AI"
        },
        "icon": "sparkles",
        "file": "page/index.html"
      }
    ],
    "actions": [
      {
        "id": "start-claude",
        "on": [
          "palette"
        ],
        "title": {
          "de": "KI im Projekt starten",
          "en": "Start an AI in a project"
        },
        "icon": "terminal"
      }
    ],
    "new": [
      {
        "id": "claude-go",
        "title": {
          "de": "KI im Projekt starten",
          "en": "Start an AI in a project"
        },
        "icon": "sparkles"
      }
    ],
    "shortcuts": [
      {
        "id": "start-claude",
        "title": {
          "de": "KI im Projekt starten",
          "en": "Start an AI in a project"
        },
        "keys": "ctrl+alt+c",
        "action": "start-claude"
      }
    ],
    "extends": [
      {
        "id": "knowledge-graph",
        "version": ">=1.5.0",
        "actions": [
          {
            "id": "graph-claude",
            "title": {
              "de": "KI mit dem Graphen fragen",
              "en": "Ask an AI with the graph"
            },
            "icon": "sparkles"
          }
        ]
      }
    ]
  },
  "synergies": [
    {
      "with": "knowledge-graph",
      "title": {
        "de": "Deine KI liest den Wissensgraphen statt Dutzender Dateien",
        "en": "Your AI reads the knowledge graph instead of dozens of files"
      }
    }
  ],
  "allowExtensions": {
    "*": [
      "tabs"
    ]
  }
}
